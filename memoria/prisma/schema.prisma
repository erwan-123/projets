// prisma/schema.prisma

// Configuration du générateur Prisma Client
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUM ROLE - Roles des utilisateurs
// ============================================
enum Role {
  ADMIN
  SUPERVISOR
  STUDENT
  JURY
}

// ============================================
// ENUM STATUS - Workflow sujets & validations
// ============================================
enum Status {
  PENDING
  APPROVED
  REJECTED
  REVISION
  COMPLETED
}

// ============================================
// MODELE USER (Utilisateur)
// ============================================
model User {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(191)
  password  String   @default("") @db.VarChar(255)
  name      String?  @db.VarChar(191)
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  memoires         Memoire[]
  proposedSujets   Sujet[]       @relation("Proposer")
  supervisedSujets Sujet[]       @relation("Superviser")
  validations      Validation[]
  notifications    Notification[]

  @@index([email])
  @@index([role])
}

// ============================================
// MODELE SUJET (Proposition de memoire)
// ============================================
model Sujet {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  description String   @db.Text
  keywords    Json?    @db.Json
  problematique String? @db.Text
  objectives     String? @db.Text
  methodology   String? @db.Text
  status      Status   @default(PENDING)
  type        String   @default("PROPOSED") @db.VarChar(50)
  feedback    String?  @db.Text
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  proposerId   String      @db.VarChar(191)
  proposer     User        @relation("Proposer", fields: [proposerId], references: [id])
  supervisorId String?     @db.VarChar(191)
  supervisor   User?       @relation("Superviser", fields: [supervisorId], references: [id])
  domainId     String?     @db.VarChar(191)
  domain       Domain?     @relation(fields: [domainId], references: [id])
  memoireId    String?     @unique @db.VarChar(191)
  memoire      Memoire?    @relation("SujetMemoire", fields: [memoireId], references: [id])
  memoireSource Memoire?   @relation("MemoireSujet")
  validations  Validation[]

  @@index([status])
  @@index([domainId])
  @@index([proposerId])
  @@index([supervisorId])
}

// ============================================
// MODELE VALIDATION (Suivi du workflow)
// ============================================
model Validation {
  id        String   @id @default(cuid())
  status    Status   @default(PENDING)
  comment   String?  @db.Text
  step      String   @db.VarChar(50) // "SUJET", "PLAN", "REDACTION", "FINAL"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sujetId     String @db.VarChar(191)
  sujet       Sujet  @relation(fields: [sujetId], references: [id], onDelete: Cascade)
  validatorId String @db.VarChar(191)
  validator   User   @relation(fields: [validatorId], references: [id])

  @@index([sujetId])
  @@index([validatorId])
  @@index([status])
  @@index([step])
}

// ============================================
// MODELE MEMOIRE
// ============================================
model Memoire {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(255)
  abstract  String?  @db.Text
  content   Json?    @db.Json
  status    String   @default("DRAFT") @db.VarChar(50)
  progress  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
   versions      Version[]
  bibliographies Bibliography[]
  plagiarismReports PlagiarismReport[]
  aiTraces      AITrace[]
  lastEditedAt  DateTime? @db.DateTime(0)
  autoSave      Boolean   @default(true)
  wordCount     Int       @default(0)
  currentVersion Int      @default(1)

  // Relations
  etudiantId String    @db.VarChar(191)
  etudiant   User      @relation(fields: [etudiantId], references: [id])
  sections   Section[]
  plan       Plan?
  timeline   Timeline[]
  domainId   String?   @db.VarChar(191)
  domain     Domain?   @relation(fields: [domainId], references: [id])
  sujetId    String?   @unique @db.VarChar(191)
  sujet      Sujet?    @relation("MemoireSujet", fields: [sujetId], references: [id])
  sujetSource Sujet?   @relation("SujetMemoire")

  @@index([etudiantId])
  @@index([status])
}

// ============================================
// MODELE SECTION (Chapitres d'un memoire)
// ============================================
model Section {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(255)
  content   Json?    @db.Json
  position  Int
  status    String   @default("DRAFT") @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  memoireId String  @db.VarChar(191)
  memoire   Memoire @relation(fields: [memoireId], references: [id], onDelete: Cascade)

  @@index([memoireId])
  @@index([position])
}
// ============================================
// MODÈLE VERSION (Historique des modifications)
// ============================================

model Version {
  id          String   @id @default(cuid())
  memoireId   String   @db.VarChar(191)
  memoire     Memoire  @relation(fields: [memoireId], references: [id], onDelete: Cascade)
  content     Json?    @db.Json
  version     Int
  userId      String   @db.VarChar(191)
  user        User     @relation(fields: [userId], references: [id])
  comment     String?  @db.VarChar(255)
  wordCount   Int      @default(0)
  createdAt   DateTime @default(now())
  
  @@index([memoireId])
  @@index([userId])
  @@index([version])
  @@index([createdAt])
}

// ============================================
// MODÈLE BIBLIOGRAPHIE (Références)
// ============================================

model Bibliography {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  authors     Json?    @db.Json           // [{name: "Dupont, J."}]
  year        String?  @db.VarChar(10)
  journal     String?  @db.VarChar(255)
  volume      String?  @db.VarChar(50)
  issue       String?  @db.VarChar(50)
  pages       String?  @db.VarChar(50)
  publisher   String?  @db.VarChar(255)
  doi         String?  @db.VarChar(100)
  isbn        String?  @db.VarChar(20)
  url         String?  @db.VarChar(255)
  type        String   @default("book") @db.VarChar(50)  // book, article, thesis, etc.
  citationKey String?  @db.VarChar(50)
  abstract    String?  @db.Text
  metadata    Json?    @db.Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  memoireId   String   @db.VarChar(191)
  memoire     Memoire  @relation(fields: [memoireId], references: [id], onDelete: Cascade)
  citations   Citation[]
  
  @@index([memoireId])
  @@index([doi])
  @@index([title])
}

// ============================================
// MODÈLE CITATION (Références dans le texte)
// ============================================

model Citation {
  id          String   @id @default(cuid())
  sectionId   String   @db.VarChar(191)
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  bibliographieId String @db.VarChar(191)
  bibliographie Bibliography @relation(fields: [bibliographieId], references: [id], onDelete: Cascade)
  context     String?  @db.Text
  position    Json?    @db.Json           // {start: 100, end: 120}
  createdAt   DateTime @default(now())
  
  @@index([sectionId])
  @@index([bibliographieId])
}

// ============================================
// MODÈLE PLAGIAT (Rapports de détection)
// ============================================

model PlagiarismReport {
  id          String   @id @default(cuid())
  memoireId   String   @db.VarChar(191)
  memoire     Memoire  @relation(fields: [memoireId], references: [id], onDelete: Cascade)
  score       Float    @default(0)
  sources     Json?    @db.Json           // [{source: "url", similarity: 0.15}]
  status      String   @default("PENDING") @db.VarChar(50)
  reportUrl   String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([memoireId])
  @@index([status])
}

// ============================================
// MODÈLE AITRACE (Traces des appels IA)
// ============================================

model AITrace {
  id          String   @id @default(cuid())
  userId      String   @db.VarChar(191)
  user        User     @relation(fields: [userId], references: [id])
  memoireId   String?  @db.VarChar(191)
  memoire     Memoire? @relation(fields: [memoireId], references: [id])
  action      String   @db.VarChar(50)   // improve, summarize, grammar, etc.
  input       String?  @db.Text
  output      String?  @db.Text
  model       String   @default("gpt-4") @db.VarChar(50)
  tokens      Int?     @db.Int
  cost        Float?   @db.Float
  duration    Int?     @db.Int           // en ms
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([memoireId])
  @@index([action])
  @@index([createdAt])
}
// ============================================
// MODELE PLAN (Plan interactif du memoire)
// ============================================
model Plan {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(255)
  structure     Json?    @db.Json
  estimatedTime Int?     @db.Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  memoireId    String        @unique @db.VarChar(191)
  memoire      Memoire       @relation(fields: [memoireId], references: [id], onDelete: Cascade)
  planSections PlanSection[]

  @@index([memoireId])
}

// ============================================
// MODELE PLAN SECTION (Elements du plan)
// ============================================
model PlanSection {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(255)
  description   String?  @db.Text
  position      Int
  estimatedTime Int?     @db.Int
  type          String   @default("chapter") @db.VarChar(50)
  level         Int      @default(0)

  // Relations
  planId   String        @db.VarChar(191)
  plan     Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  parentId String?       @db.VarChar(191)
  parent   PlanSection?  @relation("PlanHierarchy", fields: [parentId], references: [id])
  children PlanSection[] @relation("PlanHierarchy")

  @@index([planId])
  @@index([position])
}

// ============================================
// MODELE DOMAINE (Categorias de sujets)
// ============================================
model Domain {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(191)
  description String?  @db.Text
  color       String?  @db.VarChar(7)
  icon        String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  subjects Sujet[]
  memoires Memoire[]

  @@index([name])
  @@index([isActive])
}

// ============================================
// MODELE KEYWORD (Mots-cles)
// ============================================
model Keyword {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(191)
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ============================================
// MODELE TIMELINE (Chronogramme)
// ============================================
model Timeline {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  startDate   DateTime @db.DateTime(0)
  endDate     DateTime @db.DateTime(0)
  completed   Boolean  @default(false)
  position    Int
  type        String   @default("task") @db.VarChar(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  memoireId String  @db.VarChar(191)
  memoire   Memoire @relation(fields: [memoireId], references: [id], onDelete: Cascade)

  @@index([memoireId])
  @@index([startDate])
  @@index([completed])
}

// ============================================
// MODELE NOTIFICATION
// ============================================
model Notification {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @default("info") @db.VarChar(50)
  link      String?  @db.VarChar(191)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}